# BRS Engine environment template.
# Copy to .env and fill in real values for local development. Production
# values belong in the host's secret store, never committed to git.
# NOTE: .env is intentionally untracked (.gitignore); do not re-add it.

# ==============================================================================
# BASE APPLICATION SETTINGS
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ==============================================================================
# CRYPTOGRAPHY & SECURITY
# ==============================================================================
# Fernet key for at-rest encryption of uploaded chunks. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Bearer token for the X-API-Token header. Generate with: openssl rand -hex 32
API_AUTH_TOKEN=

# ==============================================================================
# DATABASE CONFIGURATION (ALEMBIC & FASTAPI)
# ==============================================================================
POSTGRES_USER=brs_user
POSTGRES_PASSWORD=
POSTGRES_DB=brs_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brs_user:__CHANGEME__@brs_postgres:5432/brs_db

# ==============================================================================
# ASYNCHRONOUS TASK QUEUE (CELERY)
# ==============================================================================
CELERY_BROKER_URL=redis://brs_redis:6379/0
POSTGRES_RESULT_BACKEND_URL=db+postgresql://brs_user:__CHANGEME__@brs_postgres:5432/brs_db

# ==============================================================================
# STORAGE PATHS (shared between brs_web and brs_worker)
# ==============================================================================
# Encrypted upload spool. In Docker this must sit on the ./var shared mount.
STORAGE_DIR=/app/var/uploads
# Trained ML artifact directory (lgbm_matcher.bin, label_encoder.pkl, tfidf_vectorizer.pkl).
MODEL_DIR=/app/var/models

# ==============================================================================
# MACHINE LEARNING & INGESTION SETTINGS
# ==============================================================================
# Probability boundary for automated FLAGGED_FOR_REVIEW mutation.
CONFIDENCE_THRESHOLD=0.70
# Iterations for RandomizedSearchCV during retraining (bounds training time).
HYPERPARAMETER_TUNING_ITERATIONS=5
# Optional hard override for the ingestion insert batch size (else adaptive).
# INGEST_CHUNK_SIZE=5000
